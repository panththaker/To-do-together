<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-build only (src/debug, not androidMain): allows plain HTTP to the
    local dev backend IP configured as TodoApiConfig.DEBUG_BASE_URL. Release
    builds don't merge this file, so production traffic stays HTTPS-only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.182</domain>
    </domain-config>
</network-security-config>
