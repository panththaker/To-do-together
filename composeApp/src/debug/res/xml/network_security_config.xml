<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-build only (src/debug, not androidMain): allows plain HTTP to
    whatever local dev backend is configured via the "debug.baseUrl" key in
    local.properties (see TodoApiConfig.DEBUG_BASE_URL and the README
    "Configuration" section). Cleartext is allowed for all domains here
    because that address is per-developer and changes machine to machine.
    Release builds don't merge this file, so production traffic stays
    HTTPS-only regardless.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
