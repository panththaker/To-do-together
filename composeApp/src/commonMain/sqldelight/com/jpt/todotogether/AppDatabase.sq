import com.jpt.todotogether.core.domain.model.ThemeOption;

-- This file defines the SQL schema and queries for the app's database using SQLDelight.

-- Settings table singleton pattern to store app-wide settings. Only one row will exist with id = 1.
CREATE TABLE Settings (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    initial_setup_ran INTEGER NOT NULL DEFAULT 0,
    counter INTEGER NOT NULL DEFAULT 0,
    theme TEXT AS ThemeOption NOT NULL DEFAULT "SYSTEM"
);

-- queries for the Settings table

initializeSettingsOrIgnore:
INSERT OR IGNORE INTO Settings (id) VALUES (1);

insertOrUpdateSettings:
INSERT OR REPLACE INTO Settings (id, initial_setup_ran, counter, theme)
VALUES (1, ?, ?, ?);

getSettings:
SELECT * FROM Settings
WHERE id = 1;


-- AuthTokens table singleton pattern to persist the signed-in user's tokens across launches. Only one row will exist with id = 1.
CREATE TABLE AuthTokens (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    access_token TEXT NOT NULL,
    refresh_token TEXT NOT NULL,
    expires_at_epoch_millis INTEGER NOT NULL,
    user_id INTEGER NOT NULL,
    user_email TEXT NOT NULL,
    user_name TEXT NOT NULL,
    user_avatar_url TEXT NOT NULL
);

saveAuthTokens:
INSERT OR REPLACE INTO AuthTokens (id, access_token, refresh_token, expires_at_epoch_millis, user_id, user_email, user_name, user_avatar_url)
VALUES (1, ?, ?, ?, ?, ?, ?, ?);

getAuthTokens:
SELECT * FROM AuthTokens
WHERE id = 1;

clearAuthTokens:
DELETE FROM AuthTokens WHERE id = 1;

-- Additional queries & tables can be defined here as needed.
